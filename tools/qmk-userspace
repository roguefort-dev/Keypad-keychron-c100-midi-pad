#!/usr/bin/env python3
"""Run QMK through a stable, space-free external-userspace path."""
import hashlib
import os
import pathlib
import sys

make, qmk_arg, userspace_arg, *targets = sys.argv[1:]
qmk = pathlib.Path(qmk_arg).resolve(strict=True)
userspace = pathlib.Path(userspace_arg).resolve(strict=True)
cache = pathlib.Path(os.environ.get("XDG_CACHE_HOME", pathlib.Path.home() / ".cache"))
cache = cache.resolve() / "keychron-c100-qmk"
if any(character.isspace() for character in str(cache)):
    cache = pathlib.Path("/tmp") / f"keychron-c100-qmk-{os.getuid()}"

# QMK records source paths in dependency files. Keep this alias between builds
# so those paths stay valid, including when the repository contains spaces.
# A private directory prevents other local users replacing its symlink.
cache.mkdir(mode=0o700, parents=True, exist_ok=True)
metadata = cache.lstat()
if cache.is_symlink() or metadata.st_uid != os.getuid() or metadata.st_mode & 0o022:
    raise SystemExit(f"QMK cache must be an owned directory without group/other write access: {cache}")
directory = cache / hashlib.sha256(os.fsencode(userspace)).hexdigest()
directory.mkdir(mode=0o700, exist_ok=True)
metadata = directory.lstat()
if directory.is_symlink() or metadata.st_uid != os.getuid() or metadata.st_mode & 0o022:
    raise SystemExit(f"Unsafe QMK userspace cache directory: {directory}")
alias = directory / "userspace"
try:
    alias.symlink_to(userspace, target_is_directory=True)
except FileExistsError:
    if not alias.is_symlink() or alias.resolve() != userspace:
        raise SystemExit(f"QMK userspace alias points elsewhere: {alias}")
os.execvp(make, [make, "-C", str(qmk), *targets, f"QMK_USERSPACE={alias}"])
