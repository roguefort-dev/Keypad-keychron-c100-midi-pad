QMK_HOME ?= ../qmk_firmware
USERSPACE_PATH ?= $(CURDIR)

.PHONY: build clean flash

build:
	+@./tools/qmk-userspace "$(MAKE)" "$(QMK_HOME)" "$(USERSPACE_PATH)" keychron/c100_8k:midi_pad

clean:
	+@./tools/qmk-userspace "$(MAKE)" "$(QMK_HOME)" "$(USERSPACE_PATH)" clean

flash: build
	@./tools/flash-c100

HOST_CC ?= cc
HOST_CFLAGS ?= -Os -Wall -Wextra -Werror
KEYMAP_DIR := keyboards/keychron/c100_8k/keymaps/midi_pad
HOST_TESTS := arp_logic chord_degree_logic note_pool pending_notes

.PHONY: test test-sanitize test-usb test-flash benchmark

test-flash:
	python3 -m unittest discover -s tests -p flash_c100_test.py

test:
	@mkdir -p .build/tests
	@set -eu; for name in $(HOST_TESTS); do \
		$(HOST_CC) -std=gnu11 $(HOST_CFLAGS) tests/$${name}_test.c -o .build/tests/$$name; \
		.build/tests/$$name; \
	done
	$(HOST_CC) -std=gnu11 $(HOST_CFLAGS) -Itests/host -I$(KEYMAP_DIR) \
		-DQMK_KEYBOARD_H='"qmk_keyboard.h"' tests/performance.c tests/host/runtime.c \
		-o .build/tests/keymap
	.build/tests/keymap --replay > .build/tests/replay.actual
	diff -u tests/keymap-replay.expected .build/tests/replay.actual
	@cat .build/tests/replay.actual

test-sanitize:
	$(MAKE) test HOST_CFLAGS="-O1 -g -Wall -Wextra -Werror -fsanitize=address,undefined -fno-omit-frame-pointer"

# Compile QMK's real descriptor resolver and the userspace override together.
# Use its ChibiOS LUFA definitions without the hardware HAL, with C100 USB
# feature flags and the identity generated by the firmware build.
test-usb: build
	@mkdir -p .build/tests
	$(HOST_CC) -std=gnu11 $(HOST_CFLAGS) -Wno-unused-parameter -fshort-wchar \
		-I"$(QMK_HOME)" -I"$(QMK_HOME)/tmk_core/protocol/chibios/lufa_utils" \
		-I"$(QMK_HOME)/platforms" -I"$(QMK_HOME)/tmk_core/protocol" \
		-I"$(QMK_HOME)/quantum" -Itests/usb -I$(KEYMAP_DIR) \
		-I"$(QMK_HOME)/tmk_core/protocol/chibios" \
		-I"$(QMK_HOME)/lib/chibios-contrib/os/hal/ports/AT32/LLD/OTGv1" \
		-include "$(QMK_HOME)/.build/obj_keychron_c100_8k_midi_pad/src/info_config.h" \
		-DMAX_ENDPOINTS=15 -DMIDI_ENABLE -DNKRO_ENABLE -DSHARED_EP_ENABLE \
		-DMOUSE_ENABLE -DMOUSE_SHARED_EP -DEXTRAKEY_ENABLE \
		-DFIXED_CONTROL_ENDPOINT_SIZE=64 -DFIXED_NUM_CONFIGURATIONS=1 \
		"$(QMK_HOME)/tmk_core/protocol/usb_descriptor.c" \
		$(KEYMAP_DIR)/usb_descriptor_midi.c $(KEYMAP_DIR)/usb_midi_transport.c \
		tests/usb_descriptor_test.c tests/usb/runtime.c -Wl,--wrap=usbStart \
		-o .build/tests/usb_descriptor
	.build/tests/usb_descriptor

benchmark:
	./tools/benchmark-local $(BENCH_ARGS)
